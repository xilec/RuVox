{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuVox",
  "version": "0.4.0",
  "identifier": "com.ruvox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RuVox",
        "width": 900,
        "height": 600,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFM0I5NTQwRTYyNUZFRDkKUldUWi9pWG1RSlU3N3NnUzdEMDFOQjF6bmpIajF0dHBKL0RYbm1PaVpLNzQ0SHgxRFk2ajNyc0IK",
      "endpoints": [
        "https://github.com/xilec/RuVox/releases/latest/download/latest.json"
      ]
    }
  }
}
