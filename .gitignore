# Rust / Tauri
src-tauri/target/
# Standalone builds of the engine crate (when built via src-tauri it shares
# src-tauri/target). Lockfile is owned by the app (src-tauri/Cargo.lock).
silero-native/target/
silero-native/Cargo.lock
src-tauri/gen/
# Third-party Windows binaries fetched at release-build time by
# scripts/fetch-windows-resources.sh. Placeholders (README/PLACEHOLDER,
# empty onnxruntime.dll) ARE committed — tauri-build checks resource path
# existence at compile time.
src-tauri/resources/mpv/*
!src-tauri/resources/mpv/PLACEHOLDER
src-tauri/resources/espeak-ng-data/*
!src-tauri/resources/espeak-ng-data/PLACEHOLDER
src-tauri/resources/crt/*
!src-tauri/resources/crt/PLACEHOLDER.dll
# Pinned mpv player bundle for the AppImage, fetched at release-build time
# by scripts/fetch-linux-mpv.sh. The README placeholder IS committed.
src-tauri/resources/mpv-linux/*
!src-tauri/resources/mpv-linux/README.md

# pnpm
.pnpm-debug.log

# Claude Code agent worktrees (per-session, never committed)
.claude/worktrees/
.claude/*.lock
